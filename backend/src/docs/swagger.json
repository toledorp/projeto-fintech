{
  "openapi": "3.0.0",
  "info": {
    "title": "LDW Backend API",
    "version": "1.0.0",
    "description": "Documentacao interativa da API REST para integracao com o Front-end React\n\nPara testar: cadastre um usu?rio em POST /users, use as mesmas credenciais em POST /auth/login e cole somente o token retornado em Authorize. Os exemplos n?o criam usu?rios automaticamente. O token expira em 1 hora."
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local de Desenvolvimento"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "summary": "Listar todos os usuarios",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "Lista de usuarios retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserListItem"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Cadastrar novo usuario",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuario criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Dados inv?lidos, campos ausentes ou e-mail j? cadastrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "summary": "Buscar usuario por ID",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Usuario encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "ID ou dados inv?lidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Usuario nao encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Atualizar dados de um usuario",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Usuario atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "ID ou dados inv?lidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Usu?rio n?o encontrado ou campo nome inv?lido (comportamento atual da API)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Remover usuario por ID",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Usuario removido com sucesso"
          },
          "400": {
            "description": "ID ou dados inv?lidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Usuario nao encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "summary": "Autenticar usuário",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token JWT gerado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "E-mail e senha são obrigatórios",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Credenciais inválidas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/lancamentos": {
      "get": {
        "summary": "Listar lançamentos do usuário autenticado",
        "tags": ["Lançamentos financeiros"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de lançamentos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/FinancialEntry"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Lista somente os lan?amentos do usu?rio autenticado, ordenados por data decrescente e depois ID decrescente."
      },
      "post": {
        "summary": "Criar lançamento financeiro",
        "tags": ["Lançamentos financeiros"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFinancialEntryDTO"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Lançamento criado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinancialEntry"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Retorna ou modifica somente lan?amentos do usu?rio autenticado. IDs de outros usu?rios retornam 404."
      }
    },
    "/lancamentos/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "integer",
            "minimum": 1
          }
        }
      ],
      "get": {
        "summary": "Buscar lançamento por ID",
        "tags": ["Lançamentos financeiros"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lançamento encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinancialEntry"
                }
              }
            }
          },
          "400": {
            "description": "ID ou dados inv?lidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Lançamento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Retorna ou modifica somente lan?amentos do usu?rio autenticado. IDs de outros usu?rios retornam 404."
      },
      "put": {
        "summary": "Atualizar lançamento financeiro",
        "tags": ["Lançamentos financeiros"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateFinancialEntryDTO"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lançamento atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinancialEntry"
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Lançamento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Aceita atualiza??o parcial. Campos omitidos mant?m o valor atual. Apenas lan?amentos do usu?rio autenticado podem ser atualizados."
      },
      "delete": {
        "summary": "Excluir lançamento financeiro",
        "tags": ["Lançamentos financeiros"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Lançamento removido"
          },
          "400": {
            "description": "ID ou dados inv?lidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Token ausente ou inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Lançamento não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Erro interno do servidor",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Retorna ou modifica somente lan?amentos do usu?rio autenticado. IDs de outros usu?rios retornam 404."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "example": "ana.silva@email.com"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-13T10:00:00.000Z",
            "format": "date-time"
          }
        }
      },
      "CreateUserDTO": {
        "type": "object",
        "required": ["nome", "email", "password"],
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "example": "ana.silva@email.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "example": "123456",
            "minLength": 6,
            "format": "password"
          }
        }
      },
      "UpdateUserDTO": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "example": "Ana Silva Atualizada"
          },
          "email": {
            "type": "string",
            "example": "ana.novo@email.com",
            "format": "email"
          }
        }
      },
      "LoginDTO": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana.silva@email.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "123456"
          }
        }
      },
      "FinancialEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "descricao": {
            "type": "string",
            "example": "Salário mensal"
          },
          "valor": {
            "type": "string",
            "example": "3500.00",
            "description": "Valor decimal retornado como texto pelo banco de dados."
          },
          "tipo": {
            "type": "string",
            "enum": ["RECEITA", "DESPESA"],
            "example": "RECEITA"
          },
          "categoria": {
            "type": "string",
            "example": "Trabalho"
          },
          "data_lancamento": {
            "type": "string",
            "format": "date",
            "example": "2026-09-22"
          },
          "user_id": {
            "type": "integer",
            "example": 1
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CreateFinancialEntryDTO": {
        "type": "object",
        "required": [
          "descricao",
          "valor",
          "tipo",
          "categoria",
          "data_lancamento"
        ],
        "properties": {
          "descricao": {
            "type": "string",
            "minLength": 2,
            "example": "Conta de energia",
            "maxLength": 200
          },
          "valor": {
            "type": "number",
            "exclusiveMinimum": true,
            "example": 180.5,
            "minimum": 0
          },
          "tipo": {
            "type": "string",
            "enum": ["RECEITA", "DESPESA"],
            "example": "DESPESA"
          },
          "categoria": {
            "type": "string",
            "example": "Moradia",
            "minLength": 1
          },
          "data_lancamento": {
            "type": "string",
            "format": "date",
            "example": "2026-09-22"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["erro"],
        "properties": {
          "erro": {
            "type": "string"
          },
          "detalhe": {
            "type": "string"
          }
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["mensagem", "token"],
        "properties": {
          "mensagem": {
            "type": "string",
            "example": "Login realizado com sucesso!"
          },
          "token": {
            "type": "string",
            "description": "JWT v?lido por 1 hora. Cole somente o token em Authorize."
          }
        }
      },
      "UserListItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nome": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "example": "ana.silva@email.com"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-09-13T10:00:00.000Z",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "UpdateFinancialEntryDTO": {
        "type": "object",
        "properties": {
          "descricao": {
            "type": "string",
            "minLength": 2,
            "example": "Conta de energia",
            "maxLength": 200
          },
          "valor": {
            "type": "number",
            "exclusiveMinimum": true,
            "example": 180.5,
            "minimum": 0
          },
          "tipo": {
            "type": "string",
            "enum": ["RECEITA", "DESPESA"],
            "example": "DESPESA"
          },
          "categoria": {
            "type": "string",
            "example": "Moradia",
            "minLength": 1
          },
          "data_lancamento": {
            "type": "string",
            "format": "date",
            "example": "2026-09-22"
          }
        }
      }
    }
  }
}
